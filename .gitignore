suburb/
invest/
sitemap-suburbs-*.xml
data/suburb-index-report.json

# Generated by build-blog.js (recreated on Netlify build)
blog/
sitemap-blog.xml

# Build cache (suburb pages persisted between Netlify deploys)
.cache/

# Netlify Functions dependencies (installed during deploy)
netlify/functions/node_modules/

# Claude Code tooling — Lighthouse + Chrome installed by .claude/hooks/session-start.sh
# inside Claude Code on the web sessions. Never deployed; never used in local dev.
.claude/tooling/

# Fetched/downloaded data caches (regenerate with fetch-abs-*.js / fetch-overpass-amenities.js)
data/abs-suburbs.json
data/abs-enhanced.json
data/abs-batch-*.json
data/au_postcodes.csv
data/abs-population-raw.json
